@model CafePOS.Models.CreateOrderViewModel

@{
    ViewData["Title"] = "Create Order";



}

<div class="container">
    <div class="mb-4">
        <h1>Create Order</h1>
        <p>Server ID: <strong>@Model.ServerID</strong></p>
    </div>

    @foreach (var category in Model.Categories)
    {
        <section class="mb-5">
            <h2>@category.CategoryName</h2>

            <div class="row g-4">
                @foreach (var item in Model.Items.Where(i => i.CategoryId == category.CategoryId))
                {
                    <div class="col-md-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h3 class="card-title">@item.ItemName</h3>

                                <p class="card-text">
                                    @item.ItemDescription
                                </p>

                                <form asp-controller="Orders"
                                      asp-action="AddItem"
                                      method="post">

                                      <input type="hidden"
                                      name="serverId"
                                      value="@Model.ServerID" />

                                      <input type="hidden"
                                      name="itemId"
                                      value="@item.ItemId" />

                                      <button type="submit" class="btn btn-primary">
                                        Add
                                      </button>
                                      </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>